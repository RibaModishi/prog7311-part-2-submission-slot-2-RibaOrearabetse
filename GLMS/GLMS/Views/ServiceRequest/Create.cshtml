@model CreateServiceRequestViewModel
@{
    ViewData["Title"] = "New service request";
}

@* External API section (USD preview + server save): assisted by DeepSeek AI — i reviewed. *@

<h1>@ViewData["Title"]</h1>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-controller="ServiceRequest" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="ContractId" class="form-label"></label>
        <select asp-for="ContractId" asp-items="ViewBag.ContractId" class="form-select"></select>
        <span asp-validation-for="ContractId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CostUsd" class="form-label"></label>
        <input asp-for="CostUsd" class="form-control" id="costUsd" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="CostUsd" class="text-danger"></span>
        <div class="form-text" id="zarPreview">ZAR (saved): —</div>
        <div class="form-text text-muted" id="rateInfo">Loading rate…</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* fetch = browser calls my JSON action; Save still recalculates ZAR on the server *@
    <script>
        (function () {
            var usdInput = document.getElementById('costUsd');
            var zarPreview = document.getElementById('zarPreview');
            var rateInfo = document.getElementById('rateInfo');
            var zarPerUsd = null;

            fetch('@Url.Action("UsdToZarRate", "ServiceRequest")')
                .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (data) {
                    zarPerUsd = data.zarPerUsd;
                    rateInfo.textContent = '1 USD = ' + zarPerUsd.toFixed(4) + ' ZAR';
                    updateZar();
                })
                .catch(function () {
                    rateInfo.textContent = 'Rate not loaded in browser — Save may still work.';
                });

            function updateZar() {
                if (zarPerUsd == null || !usdInput) return;
                var usd = parseFloat(usdInput.value);
                if (isNaN(usd) || usd <= 0) { zarPreview.textContent = 'ZAR (saved): —'; return; }
                zarPreview.textContent = 'ZAR (saved): ' + (usd * zarPerUsd).toFixed(2) + ' (preview)';
            }

            usdInput.addEventListener('input', updateZar);
        })();
    </script>
}
